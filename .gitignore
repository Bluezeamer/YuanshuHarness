.claude/

# pi运行产生的临时文件
.pi/

# 本地aisdlc评估相关
tests/aisdlc


# 依赖与构建产物
node_modules/
dist/
coverage/
*.tsbuildinfo

# 排除playwright-cli相关配置和目录
.playwright-cli/
.playwright/
.agents/skills/playwright-cli/

# server 包里的 web 产物：构建时从 packages/web/dist 复制而来
packages/server/web/
# 同上：打包时从仓库根复制进来的 NOTICE 与 licenses
packages/server/NOTICE
packages/server/licenses/
